GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# bidding2.kr A2 API (인증 불필요, {notice_id} 플레이스홀더 사용)
BIDDING2_API_URL=https://bidding2.kr/api2/module/consortiumAPI/bidFile_get.php?gongsanum={notice_id}
BIDDING2_API_KEY=

# ── 절차 엔진 MCP 서버 (procedure_mcp) · 카카오 알림톡 승인 알림 ──
# 비워 두면 승인 링크를 서버 콘솔에 표시합니다 (시험용)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_PF_ID=
KAKAO_TEMPLATE_ID=
# 휴대폰에서 열 수 있는 https 공개 주소 (알림톡 템플릿 버튼에 등록한 도메인)
PROCEDURE_PUBLIC_URL=
# 승인 주체별 휴대폰 번호: 회원=01012345678;관리자=01098765432,01011112222
PROCEDURE_APPROVER_PHONES=
# 선택: 알림톡 실패 시 문자 대체발송용 등록 발신번호
SMS_SENDER_NUMBER=
